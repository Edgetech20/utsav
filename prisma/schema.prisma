generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  email       String            @id
  name        String?
  role        String            @default("member")  // "super" | "member"
  createdAt   DateTime          @default(now())
  permissions AdminPermission[]   // legacy — only read by scripts/migrate-roles.ts; drop once all sites migrated
  roles       UserRole[]
  sessions    AdminSession[]
  assignedRsvps Rsvp[]            // RSVPs this caller must phone (see src/lib/rsvpAssign.ts)
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  perm   String // "rsvp:edit", "camp:consult", "form:volunteer-reg:view"

  @@id([roleId, perm])
}

model UserRole {
  email  String
  user   AdminUser @relation(fields: [email], references: [email], onDelete: Cascade)
  roleId Int
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Restrict) // can't delete a role still assigned

  @@id([email, roleId])
  @@index([roleId])
}

model AdminPermission {
  id       Int       @id @default(autoincrement())
  email    String
  user     AdminUser @relation(fields: [email], references: [email], onDelete: Cascade)
  resource String
  action   String    // "view" | "edit"

  @@unique([email, resource, action])
  @@index([email])
}

model AdminSession {
  token     String    @id
  email     String
  user      AdminUser @relation(fields: [email], references: [email], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email])
}

model ChangeLog {
  id        Int      @id @default(autoincrement())
  email     String
  action    String   // login | logout | create | update | delete | grant | broadcast
  resource  String   // e.g. "setting:event_title", "form:slug", "user:email", "auth"
  detail    String?  @db.Text  // JSON blob
  ip        String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model OtpStore {
  email     String   @id
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0) // wrong guesses; code is burned at 5
}

model Rsvp {
  id             Int      @id @default(autoincrement())
  name           String
  whatsapp       String   @unique
  address        String
  village        String?
  postOffice     String?
  district       String?
  pinCode        String?
  totalAttending Int?
  extraData      String?  @db.Text  // JSON: custom field values
  notes          String?  @db.Text  // admin notes
  location       String?  @db.Text  // JSON: { lat, lng, accuracy, displayName }
  submittedAt    DateTime @default(now())
  waSent         Boolean  @default(false)
  assignedTo     String?             // caller email; null = unassigned
  assignee       AdminUser? @relation(fields: [assignedTo], references: [email], onDelete: SetNull)

  @@index([assignedTo])
}

model ClickEvent {
  id        Int      @id @default(autoincrement())
  type      String   // 'view' | 'attend' | 'map'
  ip        String
  createdAt DateTime @default(now())

  @@index([type, ip])
}

model WaLog {
  id       Int      @id @default(autoincrement())
  type     String   @default("rsvp_auto")  // rsvp_auto | accommodation_auto | vehicle_auto | broadcast
  name     String
  whatsapp String
  status   String   // 'sent' | 'failed'
  error    String?
  sentAt   DateTime @default(now())
}


model FeedbackResponse {
  id          Int      @id @default(autoincrement())
  name        String
  mobile      String
  responses   String   @db.LongText  // JSON blob of all Q&A pairs
  submittedAt DateTime @default(now())
}

model Attraction {
  id              Int               @id @default(autoincrement())
  name            String
  description     String?
  order           Int               @default(0)
  url             String?
  navigateToVenue Boolean           @default(false)
  formSlug        String?           // link to a DynamicForm slug
  images          AttractionImage[]
  createdAt       DateTime          @default(now())
}

model AttractionImage {
  id           Int        @id @default(autoincrement())
  attractionId Int
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  imageUrl     String
  createdAt    DateTime   @default(now())

  @@index([attractionId])
}

model WaStatus {
  id        Int      @id @default(autoincrement())
  status    String
  qr        String?  @db.Text
  message   String?
  reason    String?
  updatedAt DateTime @updatedAt
}

model QrLink {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  targetUrl String   @default("/")
  createdAt DateTime @default(now())
  scans     QrScan[]
}

model QrScan {
  id        Int      @id @default(autoincrement())
  qrLinkId  Int
  qrLink    QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  ip        String
  scannedAt DateTime @default(now())

  @@index([qrLinkId])
}

model WaTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique  // rsvp_auto | accommodation_auto | vehicle_auto
  name      String
  body      String   @db.Text
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model WaQueue {
  id            Int       @id @default(autoincrement())
  whatsapp      String
  recipientName String
  message       String    @db.Text
  status        String    @default("pending")  // pending | sent | failed
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
}

model DynamicForm {
  id           Int                   @id @default(autoincrement())
  name         String
  slug         String                @unique
  description  String?               @db.Text
  enabled      Boolean               @default(true)
  waEnabled    Boolean               @default(false)
  waTemplate   String?               @db.Text   // message body, supports {name} {FieldLabel}
  waNameField  String?               // label of the name field for WA recipient name
  waPhoneField String?               // label of the phone field for WA delivery
  emailNotify  Boolean               @default(false)  // email all super admins on submission
  fields       DynamicFormField[]
  responses    DynamicFormResponse[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model DynamicFormField {
  id          Int         @id @default(autoincrement())
  formId      Int
  form        DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  label       String
  type        String      // text | date | textarea | select
  placeholder String?
  options     String?     @db.Text  // JSON string[] — only for select
  validation  String?     @db.Text  // JSON FieldValidation object
  required    Boolean     @default(true)
  order       Int         @default(0)

  @@index([formId])
}

model Programme {
  id          Int      @id @default(autoincrement())
  title       String
  time        String   // e.g. "10:00 AM – 11:00 AM"
  date        String?  // YYYY-MM-DD
  description String?
  venue       String?  @map("speaker")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model DynamicFormResponse {
  id          Int         @id @default(autoincrement())
  formId      Int
  form        DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        String      @db.LongText  // JSON { fieldLabel: value }
  submittedAt DateTime    @default(now())

  @@index([formId])
}

model CampDepartment {
  id       Int           @id @default(autoincrement())
  code     String        @unique  // "GM", "EY", "DN"
  name     String                 // "General Medicine"
  isActive Boolean       @default(true)
  order    Int           @default(0)
  patients CampPatient[]
  doctors  CampDoctor[]
}

model CampPatient {
  id           Int               @id @default(autoincrement())
  token        String            @unique  // "GM-001"
  name         String
  age          Int
  gender       String                     // Male | Female | Other
  mobile       String
  address      String?
  problem      String?           // chief complaint / issue described at registration
  departmentId Int
  department   CampDepartment    @relation(fields: [departmentId], references: [id])
  status       String            @default("waiting")  // waiting | called | doctor_done | completed
  doctorName   String?           // set when doctor marks consultation done
  registeredAt DateTime          @default(now())
  calledAt     DateTime?
  doctorDoneAt DateTime?
  dispensedAt  DateTime?
  completedAt  DateTime?
  medicines    PatientMedicine[]

  @@index([departmentId])
  @@index([status])
}

model Medicine {
  id        Int               @id @default(autoincrement())
  name      String
  unit      String            @default("tablet")  // tablet | capsule | ml | sachet | cream | drops
  stock     Int               @default(0)
  isActive  Boolean           @default(true)
  dispensed PatientMedicine[]

  @@index([isActive])
}

model PatientMedicine {
  id          Int         @id @default(autoincrement())
  patientId   Int
  patient     CampPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineId  Int
  medicine    Medicine    @relation(fields: [medicineId], references: [id])
  quantity    Int
  dosage      String?     // "1 tablet twice daily for 3 days"
  dispensedAt DateTime    @default(now())
  dispensedBy String?     // email

  @@index([patientId])
  @@index([medicineId])
}

model CampDoctor {
  id           Int            @id @default(autoincrement())
  name         String
  departmentId Int
  department   CampDepartment @relation(fields: [departmentId], references: [id])
  isActive     Boolean        @default(true)
  email        String?        // optional link to AdminUser for auto-filter on doctor page

  @@index([departmentId])
}

model VolDepartment {
  id         Int         @id @default(autoincrement())
  code       String      @unique  // "SEC"
  name       String               // "Security"
  isActive   Boolean     @default(true)
  order      Int         @default(0)
  cardBg     String?              // ID card background for this department (falls back to vol_card_bg)
  cardText   String?              // ID card text colour (falls back to vol_card_text)
  cardLayout String?  @db.Text    // JSON field positions on the uploaded design, see card.ts
  volunteers Volunteer[]
}

model Volunteer {
  id           Int           @id @default(autoincrement())
  code         String        @unique  // "SEC-001"
  name         String
  mobile       String
  address      String?
  departmentId Int
  department   VolDepartment @relation(fields: [departmentId], references: [id])
  responseId   Int?          @unique  // linked DynamicFormResponse it was imported from
  createdAt    DateTime      @default(now())

  @@index([departmentId])
}
