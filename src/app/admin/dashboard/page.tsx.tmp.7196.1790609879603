"use client";

import { useEffect, useState } from "react";
import { Eye, Repeat2, MapPin, CheckCircle, ClipboardList } from "lucide-react";

type Stats = { views: number; viewHits: number; attending: number; mapClicks: number; mapHits: number; rsvp?: number };

export default function AnalyticsPage() {
  const [stats, setStats] = useState<Stats | null>(null);

  useEffect(() => {
    Promise.all([
      fetch("/api/track").then(r => r.json()),
      fetch("/api/rsvp").then(r => r.json()),
    ]).then(([s, rsvp]) => setStats({ ...s, rsvp: rsvp.length }));
  }, []);

  if (!stats) return <p className="text-gray-400 text-sm">Loading…</p>;

  const cards = [
    { label: "Unique Views",   value: stats.views,                                          icon: Eye,           color: "text-blue-600",   bg: "bg-blue-50" },
    { label: "Repeat Views",   value: Math.max(0, (stats.viewHits ?? 0) - stats.views),    icon: Repeat2,       color: "text-orange-500", bg: "bg-orange-50" },
    { label: "Map Clicks",     value: stats.mapClicks ?? 0,                                 icon: MapPin,        color: "text-purple-600", bg: "bg-purple-50" },
    { label: "Attending",      value: stats.attending,                                      icon: CheckCircle,   color: "text-green-600",  bg: "bg-green-50" },
    { label: "RSVPs",          value: stats.rsvp ?? 0,                                      icon: ClipboardList, color: "text-rose-500",   bg: "bg-rose-50" },
  ];

  return (
    <div className="space-y-6">
      <h1 className="text-xl font-bold text-gray-800">Analytics</h1>
      <div className="grid grid-cols-2 gap-4">
        {cards.map(({ label, value, icon: Icon, color, bg }) => (
          <div key={label} className="bg-white rounded-2xl shadow-sm p-5 flex items-center gap-4">
            <div className={`${bg} p-3 rounded-xl`}>
              <Icon className={`w-5 h-5 ${color}`} />
            </div>
            <div>
              <p className={`text-3xl font-bold ${color}`}>{value}</p>
              <p className="text-xs text-gray-500 mt-0.5">{label}</p>
            </div>
          </div>
        ))}
      </div>
      <p className="text-xs text-gray-300 text-center">Tracked by unique IP address</p>
    </div>
  );
}
